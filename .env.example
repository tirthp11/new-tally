# ---------------------------------------------------------------------------
# abs-tally-suite environment variables
# Copy this file to cloud/backend/.env for development and fill in real values.
# Never commit a file containing real secrets.
# ---------------------------------------------------------------------------

# External PostgreSQL. Never run in Docker.
# Development : your own pgAdmin-managed PostgreSQL.
# Production  : Railway PostgreSQL - change ONLY this variable when deploying.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/abs_tally

# OpenAI (cloud backend only - the desktop connector never receives this key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin user, created automatically on startup if no users exist
ADMIN_EMAIL=admin@asiabulksacks.com
ADMIN_PASSWORD=

# Uploads (files are processed in memory and never stored)
MAX_UPLOAD_MB=15

# Connector jobs
CONNECTOR_JOB_TIMEOUT_SECONDS=60
